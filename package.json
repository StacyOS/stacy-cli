{
  "name": "stacy",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight:workspace-links": "node cli/node_modules/tsx/dist/cli.mjs scripts/ensure-workspace-package-links.ts",
    "dev": "pnpm --filter @arpanstacy/stacy-server exec tsx ../scripts/dev-runner.ts watch",
    "dev:watch": "pnpm --filter @arpanstacy/stacy-server exec tsx ../scripts/dev-runner.ts watch",
    "dev:once": "pnpm --filter @arpanstacy/stacy-server exec tsx ../scripts/dev-runner.ts dev",
    "dev:list": "pnpm --filter @arpanstacy/stacy-server exec tsx ../scripts/dev-service.ts list",
    "dev:stop": "pnpm --filter @arpanstacy/stacy-server exec tsx ../scripts/dev-service.ts stop",
    "dev:server": "pnpm --filter @arpanstacy/stacy-server dev",
    "dev:ui": "pnpm --filter @arpanstacy/stacy-ui dev",
    "storybook": "pnpm --filter @arpanstacy/stacy-ui storybook",
    "build-storybook": "pnpm --filter @arpanstacy/stacy-ui build-storybook",
    "build": "pnpm run preflight:workspace-links && pnpm -r build",
    "typecheck": "pnpm run preflight:workspace-links && pnpm -r typecheck",
    "test": "pnpm run test:run",
    "test:watch": "pnpm run preflight:workspace-links && vitest",
    "test:run": "pnpm run preflight:workspace-links && node scripts/run-vitest-stable.mjs",
    "db:generate": "pnpm --filter @arpanstacy/stacy-db generate",
    "db:migrate": "pnpm --filter @arpanstacy/stacy-db migrate",
    "issue-references:backfill": "pnpm run preflight:workspace-links && tsx scripts/backfill-issue-reference-mentions.ts",
    "secrets:migrate-inline-env": "tsx scripts/migrate-inline-env-secrets.ts",
    "db:backup": "./scripts/backup-db.sh",
    "db:restore": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts db:restore",
    "upgrade:check": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts upgrade:check",
    "stacy": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts",
    "build:npm": "./scripts/build-npm.sh",
    "release": "./scripts/release.sh",
    "release:notes": "node scripts/create-release-notes.mjs",
    "release:package-name": "node scripts/check-npm-package-name.mjs stacy-cli --expected-owner arpanstacy",
    "release:phase5-gate": "node scripts/phase5-release-gate.mjs",
    "release:stacy-cli": "node scripts/publish-stacy-cli.mjs",
    "release:stacy-cli:status": "node scripts/publish-stacy-cli.mjs --status",
    "release:stacy-cli:publish": "node scripts/publish-stacy-cli.mjs --publish",
    "release:stacy-cli:deprecate-old": "node scripts/publish-stacy-cli.mjs --deprecate-only --deprecate-old 0.3.1",
    "release:vanity-package-name": "node scripts/check-npm-package-name.mjs stacy",
    "release:canary": "./scripts/release.sh canary",
    "release:stable": "./scripts/release.sh stable",
    "release:github": "./scripts/create-github-release.sh",
    "release:rollback": "./scripts/rollback-latest.sh",
    "check:tokens": "node scripts/check-forbidden-tokens.mjs",
    "docs:dev": "cd docs && npx mintlify dev",
    "smoke:openclaw-join": "./scripts/smoke/openclaw-join.sh",
    "smoke:docker-quickstart": "./scripts/docker-quickstart-smoke.sh",
    "smoke:stacy-cli-npm": "node scripts/smoke/stacy-cli-npm-smoke.mjs",
    "smoke:openclaw-docker-ui": "./scripts/smoke/openclaw-docker-ui.sh",
    "smoke:openclaw-sse-standalone": "./scripts/smoke/openclaw-sse-standalone.sh",
    "smoke:heartbeat-worker-owned": "node scripts/smoke/heartbeat-worker-owned-phase2.mjs",
    "smoke:codex-local-real": "node cli/node_modules/tsx/dist/cli.mjs scripts/smoke/local-adapter-real-smoke.ts codex",
    "smoke:claude-local-real": "node cli/node_modules/tsx/dist/cli.mjs scripts/smoke/local-adapter-real-smoke.ts claude",
    "smoke:phase4-local-adapters": "node cli/node_modules/tsx/dist/cli.mjs scripts/smoke/local-adapter-real-smoke.ts codex claude",
    "smoke:codex-local-preflight": "node cli/node_modules/tsx/dist/cli.mjs scripts/smoke/local-adapter-real-smoke.ts --preflight codex",
    "smoke:claude-local-preflight": "node cli/node_modules/tsx/dist/cli.mjs scripts/smoke/local-adapter-real-smoke.ts --preflight claude",
    "smoke:phase4-local-adapters-preflight": "node cli/node_modules/tsx/dist/cli.mjs scripts/smoke/local-adapter-real-smoke.ts --preflight codex claude",
    "qa:todo-app-e2e": "node scripts/qa/todo-app-e2e.mjs",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --config tests/e2e/playwright.config.ts --headed",
    "test:e2e:multiuser-authenticated": "npx playwright test --config tests/e2e/playwright-multiuser-authenticated.config.ts",
    "evals:smoke": "cd evals/promptfoo && npx promptfoo@0.103.3 eval",
    "test:release-smoke": "npx playwright test --config tests/release-smoke/playwright.config.ts",
    "test:release-smoke:headed": "npx playwright test --config tests/release-smoke/playwright.config.ts --headed",
    "metrics:stacy-commits": "tsx scripts/stacy-commit-metrics.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "patchedDependencies": {
      "embedded-postgres@18.1.0-beta.16": "patches/embedded-postgres@18.1.0-beta.16.patch"
    },
    "overrides": {
      "defu": "6.1.7",
      "esbuild": "0.27.7",
      "fast-xml-parser": "5.7.2",
      "hono": "4.12.16",
      "kysely": "0.28.16",
      "lodash-es": "4.18.1",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.4",
      "postcss": "8.5.13",
      "rollup": ">=4.59.0",
      "uuid": "14.0.0",
      "vite@^6.0.0": "6.4.2",
      "vite@^7.0.0": "7.3.2"
    }
  }
}
