{
  "name": "@arpanstacy/stacy",
  "version": "0.3.1",
  "description": "Stacy CLI — setup, diagnose, and run a trust-first AI control plane",
  "type": "module",
  "bin": {
    "stacy": "./dist/index.js"
  },
  "keywords": [
    "stacy",
    "ai",
    "agents",
    "orchestration",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StacyOS/stacy-cli",
    "directory": "cli"
  },
  "homepage": "https://github.com/StacyOS/stacy-cli",
  "bugs": {
    "url": "https://github.com/StacyOS/stacy-cli/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node --input-type=module -e \"import esbuild from 'esbuild'; import config from './esbuild.config.mjs'; await esbuild.build(config);\" && chmod +x dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "@arpanstacy/stacy-adapter-claude-local": "workspace:*",
    "@arpanstacy/stacy-adapter-codex-local": "workspace:*",
    "@arpanstacy/stacy-adapter-cursor-local": "workspace:*",
    "@arpanstacy/stacy-adapter-gemini-local": "workspace:*",
    "@arpanstacy/stacy-adapter-opencode-local": "workspace:*",
    "@arpanstacy/stacy-adapter-pi-local": "workspace:*",
    "@arpanstacy/stacy-adapter-openclaw-gateway": "workspace:*",
    "@arpanstacy/stacy-adapter-utils": "workspace:*",
    "@arpanstacy/stacy-db": "workspace:*",
    "@arpanstacy/stacy-server": "workspace:*",
    "@arpanstacy/stacy-shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "dotenv": "^17.0.1",
    "commander": "^13.1.0",
    "embedded-postgres": "^18.1.0-beta.16",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
